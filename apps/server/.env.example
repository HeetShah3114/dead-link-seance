# Copy to .env (git-ignored) and fill in. Never commit real values.
# Publishing to R2 is on only when DEPLOY_BUCKET and DEPLOY_BASE_URL are both set.
DEPLOY_BUCKET=dead-link-seance-sites
DEPLOY_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
DEPLOY_BASE_URL=https://dead-link-seance-sites.<your-subdomain>.workers.dev
# R2 API token (S3 access key), scoped to read/write on this bucket only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AI gap-filling (optional). Without these, sites are built with no AI text.
# Workers AI token: Cloudflare dashboard > Workers AI > Use REST API > Create a Workers AI API Token.
CF_ACCOUNT_ID=<account_id>
CF_AI_TOKEN=
# CF_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# AI_CALLS_PER_DAY=30

# Takedown route DELETE /api/sites/:siteId (header x-admin-token). Off when unset.
# Must be 24+ random characters, e.g. node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# ADMIN_TOKEN=

# Demo sites shown on the home page (written by scripts/pin-examples.ts).
# EXAMPLES_FILE=examples.json
